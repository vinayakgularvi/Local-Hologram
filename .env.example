# Copy to .env and adjust. Loaded from repo root and backend/ when starting uvicorn.
#
# FastAPI / uvicorn listen port (default 8080 in this repo; `npm run dev` sets PORT for backend + Vite proxy).
# PORT=8080

# Browser CORS: comma-separated exact origins. Defaults include localhost/127.0.0.1 on common Vite ports (http+https).
# When CORS_ORIGIN_REGEX is unset, the API also allows RFC1918 private LAN IPs on any port (e.g. https://10.29.145.124:5175).
# CORS_ORIGINS=https://10.29.145.124:5175,http://localhost:5173
# To disable the default LAN regex and use only CORS_ORIGINS, set an empty regex in .env:
# CORS_ORIGIN_REGEX=
# Custom regex example: CORS_ORIGIN_REGEX=^https://10\.29\.145\.124(:\d+)?$
#
# 502 Bad Gateway on /api/* through nginx: usually wrong upstream port/host (match PORT, e.g. 127.0.0.1:8080), not CORS.
#
# --- Production / Docker (ENVIRONMENT=production or PRODUCTION=1) ---
# CORS: no implicit Vite localhost list; no LAN origin regex unless you set CORS_ALLOW_PRIVATE_NETWORK=1.
# Set CORS_ORIGINS=https://your.public.host (comma-separated) and/or CORS_ORIGIN_REGEX=...
# TRUSTED_HOSTS=localhost,127.0.0.1,your.public.host   # optional; Host header allow-list (include localhost for in-container health checks)
# TRUST_FORWARDED=1   # behind a reverse proxy; set PROXY_TRUSTED_HOSTS to proxy IPs/CIDRs instead of default "*"
# PROXY_TRUSTED_HOSTS=10.0.0.2,127.0.0.1
# SECURITY_HEADERS=1   # force security headers in non-production too (on by default in production)
#
# Docker: `docker compose up --build -d` (see docker-compose.yml). Use TLS at your edge proxy; keep secrets in env, not in the image.

# --- Feature toggles (default off) — avatar Q&A still saves to MongoDB when MONGODB_ENABLED=true ---
# VIDEO_RAG_ENABLED=false          # hologram Qdrant cache + Video RAG dashboard playback match
# OFFLINE_EXPORTS=false            # LiveTalking offline lip-sync → remote Qdrant ingest
# MONGODB_EXPORT_TRIGGER=false     # auto-queue offline export on Mongo insert (needs OFFLINE_EXPORTS=true)

LIPSYNC_FILE_API_URL=http://10.29.145.124:8000/lipsync/file
LIPSYNC_CHECKPOINT_PATH=checkpoints/checkpoints/Wav2Lip-SD-GAN.pt
LIPSYNC_FPS=25
LIPSYNC_FACE_DET_BATCH_SIZE=16
LIPSYNC_WAV2LIP_BATCH_SIZE=128
LIPSYNC_PAD_TOP=0
LIPSYNC_PAD_BOTTOM=10
LIPSYNC_PAD_LEFT=0
LIPSYNC_PAD_RIGHT=0
LIPSYNC_CROP_TOP=0
LIPSYNC_CROP_BOTTOM=-1
LIPSYNC_CROP_LEFT=0
LIPSYNC_CROP_RIGHT=-1
LIPSYNC_BOX_TOP=-1
LIPSYNC_BOX_BOTTOM=-1
LIPSYNC_BOX_LEFT=-1
LIPSYNC_BOX_RIGHT=-1
LIPSYNC_RESIZE_FACTOR=1
LIPSYNC_ROTATE=false
LIPSYNC_NOSMOOTH=false

# Speed / realtime (defaults favor one Gradio call = fastest)
# LIPSYNC_REALTIME=1           # lip-sync segments while Ollama streams (recommended)
# LIPSYNC_USE_CHUNKS=0         # 1/true = batch chunk mode on full wav (slow). OR a number >1 = realtime target segment seconds
# LIPSYNC_RT_TARGET_SEC=4      # if USE_CHUNKS is not a number, this sets realtime segment size (seconds-ish via char cap)
# LIPSYNC_RT_MIN_CHARS=16
# LIPSYNC_CHUNK_SEC=6
# LIPSYNC_AUTO_SINGLE_BELOW_SEC=60
# LIPSYNC_CHUNK_PARALLEL=1

OLLAMA_BASE=http://10.29.145.124:8000
OLLAMA_MODEL=AFM-4.5B-Q4_K_M.gguf
# MODEL_API_STYLE=auto           # auto|openai|ollama (use openai for /v1/chat/completions servers)

# LLM provider for voice turns, RAG answers, and /api/lipsync* (default: local = Ollama / compatible server above)
# LLM_PROVIDER=local             # local | openai | anthropic | google
# OpenAI (https://api.openai.com/v1/chat/completions when base is default)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini
# Anthropic Messages API (https://api.anthropic.com/v1/messages)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# Google Gemini (Generative Language API — streamGenerateContent + alt=sse)
# GOOGLE_API_KEY=
# Or: GEMINI_API_KEY=            # alias read by the server if GOOGLE_API_KEY is unset
# GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# GOOGLE_GEMINI_MODEL=gemini-2.0-flash
# VOICE_MAX_TOKENS=96            # lower is faster; tune 48-128 for short avatar replies
# VITE_VOICE_SILENCE_MS=4000     # auto-stop after this much silence once you have spoken (ms)
# VITE_MIC_SILENCE_RMS=0.014     # mic level treated as speech (lower = more sensitive)
# VITE_VOICE_FINAL_STOP_MS=220   # stop quickly after first final speech result
# VITE_VOICE_DEFAULT_LANG=en-US  # STT language hint → Whisper "english", "chinese", etc.
# Server STT (mic tap → record → POST /api/transcribe → distil-whisper)
# TRANSCRIBE_API_URL=http://10.29.145.124:8000/api/transcribe
# TRANSCRIBE_MODEL_ID=distil-whisper/distil-large-v3
# TRANSCRIBE_DEFAULT_LANGUAGE=english
# TRANSCRIBE_TIMEOUT_SEC=120
# TRANSCRIBE_MAX_UPLOAD_MB=12
# VITE_MIC_MAX_RECORD_MS=45000
# TRANSCRIBE_MODE=chunked              # sequential | chunked (chunked = lower latency on Whisper API)
# TRANSCRIBE_CHUNK_LENGTH_S=10         # seconds per Whisper window when mode=chunked
# TRANSCRIBE_STRIDE_LENGTH_S=0         # overlap between windows (optional)
# VITE_TRANSCRIBE_MODE=chunked
# VITE_TRANSCRIBE_LIVE_CHUNK_LENGTH_S=5  # smaller windows for live partial requests
# VITE_TRANSCRIBE_LIVE_CHUNK_MS=2500   # live partial transcribe interval while recording (0=off)
# VITE_TRANSCRIBE_LIVE_MIN_MS=1500     # min record time before first live chunk
# VITE_TRANSCRIBE_LIVE_MIN_BYTES=8000  # min audio bytes before live chunk request
# Parallel live STT (lower latency): 20ms MediaRecorder slices, each POST in parallel, joined at end
# VITE_TRANSCRIBE_PARALLEL_SLICES=1
# VITE_STT_BROWSER_INTERIM=1           # Chromium Speech API for <200ms interim (default on with parallel)
# VITE_TRANSCRIBE_SLICE_MS=20          # MediaRecorder timeslice (ms)
# VITE_TRANSCRIBE_SLICE_BATCH_MS=80    # batch slices per Whisper call (0 = every timeslice)
# VITE_TRANSCRIBE_SLICE_MIN_RECORD_MS=80
# VITE_TRANSCRIBE_SLICE_MIN_BYTES=600
# VITE_TRANSCRIBE_DIRECT_URL=          # optional: hit TRANSCRIBE host directly (needs CORS)
# TRANSCRIBE_SLICE_MODEL_ID=           # optional faster model for live slices only
# TRANSCRIBE_SLICE_MAX_NEW_TOKENS=32
# TRANSCRIBE_SLICE_BATCH_SIZE=1
# Live slices use mode=sequential (not chunked); slice=1 is only for the Hologram proxy.
# Set VITE_TRANSCRIBE_LIVE_CHUNK_MS=0 when using parallel slices (recommended)
# VITE_TRANSCRIBE_CHUNK_LENGTH_S=10    # final transcribe chunk_length_s (mode=chunked)
# VITE_CAPTION_HIDE_MS=2000   # clear avatar caption this long after transcript text appears
# VITE_MIC_TONE_ON_MS=380     # mic record-start beep length
# VITE_MIC_TONE_OFF_MS=340    # mic record-stop beep length
# VITE_MIC_TONE_TAP_MS=80     # mic button tap beep length
# VITE_MIC_PULSE_SEC=2.2      # listening ring pulse period on mic button
# VITE_WEBRTC_ICE_GATHER_TIMEOUT_MS=250  # send offer faster (ms)
# VITE_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
# Idle hologram loop on /avatar (WebRTC only while answering). File under frontend/public/
# VITE_IDLE_LOOP_VIDEO=/Videofile.mp4
# (or frontend/public/Videofile.mp4 — normalized to /Videofile.mp4 at runtime)
# VITE_LIP_SYNC_AVATAR_MIN_DELTA_SEC=0.15  # min video timeline advance before "lip-sync avatar play" (analytics)
# VITE_WEBRTC_AUDIO_PLAY_MIN_DELTA_SEC=0.35  # min audio timeline advance before counting WebRTC audio as playing (analytics)
# Optional system-style line for POST /api/voice-turn (mic → Ollama → LiveTalking)
# VOICE_OLLAMA_INSTRUCTION=You are a concise hologram assistant...

# LiveTalking-style WebRTC: FastAPI forwards POST /offer, /human, /record, /interrupt_talk to this origin
# WEBRTC_SIGNALING_BASE=http://127.0.0.1:8010
# Hologram mic tap calls POST /interrupt_talk with the sessionid from /offer (stops TTS + cached Video Q&A clip).
# Avatar Studio → Hologram Avatar (proxied when WEBRTC_SIGNALING_BASE is set):
# POST /api/avatar/hologram/upload/video|audio, GET /api/avatar/hologram/assets,
# POST /api/avatar/hologram/prepare (server paths saved in backend/data/avatar_studio.db)
# HOLOGRAM_UPLOAD_TIMEOUT_SEC=600
# HOLOGRAM_PREPARE_TIMEOUT_SEC=900
# Avatar/voice-clone Gradio app base (used by /api/avatar/* endpoints)
# AVATAR_API_BASE=http://10.29.145.124:9000
# AVATAR_SAMPLE_TEXT=Read this script while recording your voice sample.
# Controlled avatar video (POST /generate-controlled, GET /jobs/{id}, GET /jobs/{id}/video)
# AVATAR_VIDEO_API_BASE=http://10.29.145.124:8002
# AVATAR_VIDEO_GENERATE_TIMEOUT_SEC=600
# AVATAR_VIDEO_JOB_TIMEOUT_SEC=120

# ChromaDB RAG (Avatar Studio — PDF / DOCX / TXT ingest). Data: backend/data/chroma/
# RAG_MAX_UPLOAD_MB=25
# RAG_CHUNK_SIZE=900
# RAG_CHUNK_OVERLAP=120
# Optional: wipe entire vector store (POST /api/rag/reset with body {"secret":"..."})
# RAG_RESET_SECRET=

# RAG in live voice pipeline (POST /api/voice-turn): Chroma retrieval → Ollama prompt
# VOICE_RAG_ENABLED=1
# VOICE_RAG_N_RESULTS=6
# VOICE_RAG_MAX_CONTEXT_CHARS=3500

# RAG generate stream: POST JSON to external API. When set, POST /api/voice-turn and POST /api/rag/query
# use this URL instead of Ollama (OLLAMA_BASE) for the language model reply. Chroma retrieval still runs locally when enabled.
# Body shape: {"conversation":[{"role":"system","content":"…"},{"role":"user","content":"…"}]}
# Voice-turn adds for_voice_tts:true. Model may append <show_image>{"items":[{"name":"Latte"}]}</show_image> for UI;
# speak_text strips tags before LiveTalking /human (TTS). Analytics records RAG latency (POST stream start → response done).
# VOICE_DISPATCH_HUMAN=1 — after voice-turn, API POSTs /human to WEBRTC_SIGNALING_BASE (faster than browser round-trip).
# VOICE_STREAM_HUMAN=1 — while reading RAG_GENERATE_STREAM_URL, dispatch chunks to /human as they complete.
# VOICE_STREAM_HUMAN_UNIT=sentence   # sentence (default) or word
# VOICE_STREAM_HUMAN_WORDS_PER_CHUNK=1   # word mode only: 1=each word, 3=three words per /human call
# VOICE_STREAM_HUMAN_MIN_CHARS=4     # sentence default; use 1 for word mode
# HUMAN_DISPATCH_TIMEOUT_SEC=90
# RAG_GENERATE_STREAM_URL=http://localhost:9000/api/generate/stream
# RAG_GENERATE_STREAM_TIMEOUT_SEC=120
# RAG_GENERATE_STREAM_MAX_CHARS=400000

# Vector databases (optional; Avatar Studio can save overrides to backend/data/studio_integrations.json)
# RAG still uses ChromaDB until a vector pipeline reads these.
# Pinecone (serverless / pod)
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# Optional index host from the Pinecone console (region-specific endpoint)
# PINECONE_HOST=
# Milvus or Zilliz Cloud
# MILVUS_URI=http://127.0.0.1:19530
# MILVUS_TOKEN=
# MILVUS_DB_NAME=default
# MILVUS_COLLECTION_NAME=

# Weaviate
# WEAVIATE_URL=http://localhost:8080
# WEAVIATE_API_KEY=
# WEAVIATE_CLASS_NAME=Document

# Qdrant (Video RAG + optional Avatar Studio vector DB)
QDRANT_URL=http://10.29.145.124:6333
# QDRANT_API_KEY=              # optional for local; required for Qdrant Cloud
QDRANT_COLLECTION_NAME=video_qa
# Video Q&A uses QDRANT_URL + collection above; override collection only for video QA:
# VIDEO_QA_QDRANT_COLLECTION=video_qa
# Embedding model for vector search (768-dim, matches video_qa collection):
# VIDEO_QA_EMBED_MODEL=BAAI/bge-base-en-v1.5
# Live hologram Video RAG (requires VIDEO_RAG_ENABLED=true): Qdrant match on voice turn
# VIDEO_QA_VOICE_MATCH=true
# VIDEO_QA_MATCH_THRESHOLD=0.9
# Terminal debug lines prefixed [hologram HH:MM:SS] (set HOLOGRAM_TRACE=0 to disable)
# HOLOGRAM_TRACE=1

# Video Q&A processing (trim leading silence + transcribe → answer):
# VIDEO_QA_SILENCE_NOISE_DB=-45
# VIDEO_QA_SILENCE_MIN_SEC=0.25
# VIDEO_QA_MAX_TRIM_SEC=120

# Offline exports — set OFFLINE_EXPORTS=true to enable (see feature toggles above)
# OFFLINE_EXPORTS_BASE_URL=http://10.29.145.124:8010
# OFFLINE_EXPORTS_BASE_URL=http://10.29.145.124:8010
# OFFLINE_EXPORT_PROFILE_ID=working_profile
# OFFLINE_EXPORT_TTS_SERVER=http://10.29.145.124:9000
# OFFLINE_EXPORT_GPU_ID=6
# OFFLINE_EXPORT_POLL_SEC=4
# OFFLINE_EXPORT_POLL_MAX_SEC=3600
# OFFLINE_EXPORT_BG_POLL_SEC=8

# Garage S3 — Video RAG video storage (S3-compatible)
GARAGE_S3_ENDPOINT=http://10.29.145.124:3900
VIDEO_QA_S3_BUCKET=video-qa
# Video RAG playback CDN — public URL is {VIDEO_QA_CDN_BASE}/{filename} (e.g. answer_<id>_<ts>.mp4)
# Playback uses CDN only (no backend/data/videos). Uploads/processing still use Garage S3.
VIDEO_QA_CDN_BASE=http://10.29.145.124:5080/live/streams/video-qa
# VOD registry — GET {base}/{filename} → available, vod_url, file_size_bytes
VIDEO_QA_VOD_STATUS_BASE=http://10.29.145.124:8090/vod/status
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage

# MongoDB — avatar Q&A + voice-turn analytics (async, per POST /api/voice-turn)
# MONGODB_ENABLED=true
# MONGODB_URI=mongodb://admin:admin@localhost:27017/?authSource=admin
# Or set host/user/password separately:
# MONGODB_HOST=localhost
# MONGODB_PORT=27017
# MONGODB_USERNAME=admin
# MONGODB_PASSWORD=admin
# MONGODB_AUTH_SOURCE=admin
# MONGODB_DATABASE=local_hologram
# MONGODB_AVATAR_TURNS_COLLECTION=avatar_turns
# MONGODB_DISABLE=0
# When a new doc is inserted, queue offline export (needs OFFLINE_EXPORTS=true + MONGODB_EXPORT_TRIGGER=true):
# MONGODB_EXPORT_TRIGGER=true
# MONGODB_EXPORT_TRIGGER_COLLECTION=avatar_turns
# Before POST /api/offline-exports: skip if Qdrant already has same id + question + answer (100% text match)
# MONGODB_EXPORT_CHANGE_STREAM=true
# Optional: only trigger via Mongo insert (skip direct export on POST /api/video-qa/ask):
# MONGODB_EXPORT_TRIGGER_ONLY=true

# Elasticsearch (REST; use API key id:secret Base64 for Elastic Cloud)
# ELASTICSEARCH_URL=https://localhost:9200
# ELASTICSEARCH_API_KEY=
# ELASTICSEARCH_INDEX_NAME=kb_vectors

# Azure AI Search (Azure Cognitive Search)
# AZURE_AI_SEARCH_ENDPOINT=https://your-service.search.windows.net
# AZURE_AI_SEARCH_API_KEY=
# AZURE_AI_SEARCH_INDEX_NAME=kb-index

# Microsoft SharePoint → Chroma (Graph API, application permissions)
# Register an app in Azure Entra ID; add Microsoft Graph application permissions (admin consent), e.g. Sites.Read.All
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# SHAREPOINT_SITE_URL=https://yourtenant.sharepoint.com/sites/YourSite
# Optional: folder under the default document library root (use "Shared Documents/Subfolder" style paths)
# SHAREPOINT_FOLDER_PATH=
# Optional: use a specific drive ID instead of the site's default library
# SHAREPOINT_DRIVE_ID=
# SHAREPOINT_MAX_FILES=80
# SHAREPOINT_MAX_DEPTH=6
# SHAREPOINT_MAX_BYTES=26214400
# SHAREPOINT_ALLOWED_SUFFIXES=.pdf,.docx,.txt,.md
# Continuous background sync into Chroma (same as manual sync; uses a lock so runs never overlap)
# SHAREPOINT_LIVE_SYNC=1
# SHAREPOINT_SYNC_INTERVAL_SEC=90

# Google Drive → Chroma (Drive API v3, service account)
# Enable Drive API in GCP; create a service account and download JSON key.
# Share your target folder with the service account email (Viewer is enough).
# GOOGLE_DRIVE_CREDENTIALS_PATH=backend/secrets/gdrive-sa.json
# GOOGLE_DRIVE_FOLDER_ID=
# GOOGLE_DRIVE_MAX_FILES=80
# GOOGLE_DRIVE_MAX_DEPTH=6
# GOOGLE_DRIVE_MAX_BYTES=26214400
# GOOGLE_DRIVE_ALLOWED_SUFFIXES=.pdf,.docx,.txt,.md
# GOOGLE_DRIVE_LIVE_SYNC=1
# GOOGLE_DRIVE_SYNC_INTERVAL_SEC=90

# Dropbox → Chroma (files.content.read scope)
# Create a Dropbox app; for servers prefer a refresh token + app key/secret.
# DROPBOX_ACCESS_TOKEN=
# Or:
# DROPBOX_REFRESH_TOKEN=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# Optional folder (default: account / app root). Example: /Handbook
# DROPBOX_FOLDER_PATH=
# DROPBOX_MAX_FILES=80
# DROPBOX_MAX_DEPTH=6
# DROPBOX_MAX_BYTES=26214400
# DROPBOX_ALLOWED_SUFFIXES=.pdf,.docx,.txt,.md
# DROPBOX_LIVE_SYNC=1
# DROPBOX_SYNC_INTERVAL_SEC=90

# Amazon S3 → Chroma (boto3)
# S3_BUCKET=
# Optional key prefix (virtual folders under this prefix are crawled)
# S3_PREFIX=
# Region if not implicit from default chain
# AWS_REGION=us-east-1
# Or rely on instance/profile credentials:
# S3_USE_DEFAULT_CREDENTIAL_CHAIN=1
# Or explicit keys (omit if using default chain):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# S3_MAX_FILES=80
# S3_MAX_DEPTH=8
# S3_MAX_BYTES=26214400
# S3_ALLOWED_SUFFIXES=.pdf,.docx,.txt,.md
# S3_LIVE_SYNC=1
# S3_SYNC_INTERVAL_SEC=90

# Azure Blob Storage → Chroma (azure-storage-blob)
# AZURE_BLOB_CONTAINER=
# AZURE_BLOB_PREFIX=
# Either a full connection string:
# AZURE_STORAGE_CONNECTION_STRING=
# Or account name + key:
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=
# AZURE_BLOB_MAX_FILES=80
# AZURE_BLOB_MAX_DEPTH=8
# AZURE_BLOB_MAX_BYTES=26214400
# AZURE_BLOB_ALLOWED_SUFFIXES=.pdf,.docx,.txt,.md
# AZURE_BLOB_LIVE_SYNC=1
# AZURE_BLOB_SYNC_INTERVAL_SEC=90

# Google Cloud Storage → Chroma (google-cloud-storage)
# GCS_BUCKET=
# GCS_PREFIX=
# Service account JSON path (or standard env):
# GCS_CREDENTIALS_PATH=
# GOOGLE_APPLICATION_CREDENTIALS=
# Or workload / local gcloud ADC:
# GCS_USE_ADC=1
# GCS_MAX_FILES=80
# GCS_MAX_DEPTH=8
# GCS_MAX_BYTES=26214400
# GCS_ALLOWED_SUFFIXES=.pdf,.docx,.txt,.md
# GCS_LIVE_SYNC=1
# GCS_SYNC_INTERVAL_SEC=90

# Avatar Studio can save the above connector settings via the UI to:
# backend/data/studio_integrations.json (overrides .env until cleared). Gitignored by default.
# Global live-sync master (Avatar Studio UI toggle): backend/data/studio_live_sync.json
# {"master_enabled": false} pauses all cloud → Chroma background loops; per-source *\_LIVE_SYNC env still applies.
