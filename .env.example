# Copy to .env and adjust. Loaded from repo root and backend/ when starting uvicorn.
# Vite reads VITE_* from repo root (see frontend/vite.config.js envDir).

# PORT=8080

# =============================================================================
# Browser CORS / reverse proxy
# =============================================================================
# Comma-separated origins. Defaults include localhost Vite ports + optional LAN regex.
# CORS_ORIGINS=https://10.29.145.124:5175,http://localhost:5173
# CORS_ORIGIN_REGEX=
# 502 on /api/* via nginx: fix upstream host:port to match PORT (e.g. 127.0.0.1:8080).

# =============================================================================
# Production / Docker (ENVIRONMENT=production or PRODUCTION=1)
# =============================================================================
# CORS_ORIGINS=https://your.public.host
# TRUSTED_HOSTS=localhost,127.0.0.1,your.public.host
# TRUST_FORWARDED=1
# PROXY_TRUSTED_HOSTS=10.0.0.2,127.0.0.1
# SECURITY_HEADERS=1

# =============================================================================
# Feature toggles (default off)
# =============================================================================
# VIDEO_RAG_ENABLED=false
# OFFLINE_EXPORTS=false
# MONGODB_EXPORT_TRIGGER=false
# Terminal voice/RAG/TTS logs (grep ``voice |`` in uvicorn output). Default on.
# HOLOGRAM_TRACE=1

# =============================================================================
# Lip-sync (Wav2Lip file API)
# =============================================================================
# LIPSYNC_FILE_API_URL=http://10.29.145.124:8000/lipsync/file
# LIPSYNC_CHECKPOINT_PATH=checkpoints/checkpoints/Wav2Lip-SD-GAN.pt
# LIPSYNC_FPS=25
# LIPSYNC_FACE_DET_BATCH_SIZE=16
# LIPSYNC_WAV2LIP_BATCH_SIZE=128
# LIPSYNC_REALTIME=1
# LIPSYNC_USE_CHUNKS=0

# =============================================================================
# LLM (voice-turn, RAG answers, lipsync text)
# =============================================================================
# OLLAMA_BASE=http://10.29.145.124:8000
# OLLAMA_MODEL=AFM-4.5B-Q4_K_M.gguf
# MODEL_API_STYLE=auto
# LLM_PROVIDER=local
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# VOICE_MAX_TOKENS=96
# VOICE_OLLAMA_INSTRUCTION=You are a concise hologram assistant

# RAG stream → LiveTalking while LLM streams
# VOICE_DISPATCH_HUMAN=1
# VOICE_STREAM_HUMAN=1
# sentence = one /v1/tts call per finished sentence (. ! ? or newline)
# VOICE_STREAM_HUMAN_UNIT=sentence
# VOICE_STREAM_HUMAN_UNIT=word
# VOICE_STREAM_HUMAN_WORDS_PER_CHUNK=3
# VOICE_STREAM_HUMAN_MIN_CHARS=4
# VOICE_DISPATCH_MODE=human
# VOICE_DISPATCH_MODE=humanaudio
# VITE_VOICE_PIPELINE_API=/api/voice-stream
# VOICE_TTS_API_URL=http://10.29.145.124:9000/v1/tts/reference
# VOICE_TTS_REFERENCE_ID=ref101
# VOICE_TTS_STYLE_PRESET=calm_joyful
# VOICE_TTS_SPEED=0.75
# VOICE_TTS_USE_CACHE=true
# VOICE_TTS_OVERWRITE=false
# VOICE_TTS_FIX_DURATION=0
# VOICE_TTS_FLUSH_SENTENCE=1
# Parallel TTS while RAG streams; humanaudio uploads stay ordered (default on)
# VOICE_STREAM_PARALLEL=1
# VOICE_TTS_MAX_PARALLEL=4
# HOLOGRAM_TRACE=1  # [hologram HH:MM:SS] voice | … in backend terminal
# HUMAN_DISPATCH_TIMEOUT_SEC=90
# RAG /v1/chat default when no WebRTC session (studio). Voice uses LiveTalking UUID from /offer.
# HOLOGRAM_SESSION_ID=123
# RAG_SESSION_ID=123
# Active hologram avatar (set via Create Avatar → Set avatar; shared across devices)
# HOLOGRAM_SELECTED_AVATAR_ID=new_avatar
# RAG_GENERATE_STREAM_URL=http://localhost:9090/v1/chat
# Legacy stream: RAG_GENERATE_STREAM_URL=http://localhost:9090/api/generate/stream
# RAG_CHAT_TOP_K=6

# Chroma document RAG (backend/data/chroma/)
# RAG_MAX_UPLOAD_MB=25
# RAG_CHUNK_SIZE=900
# RAG_CHUNK_OVERLAP=120
# RAG_RESET_SECRET=
# VOICE_RAG_ENABLED=1
# VOICE_RAG_N_RESULTS=6

# =============================================================================
# WebRTC / LiveTalking
# =============================================================================
# WEBRTC_SIGNALING_BASE=http://127.0.0.1:8010
# VOICE_DISPATCH_MODE=humanaudio
# HOLOGRAM_UPLOAD_TIMEOUT_SEC=600
# HOLOGRAM_PREPARE_TIMEOUT_SEC=900

# =============================================================================
# Avatar services
# =============================================================================
# AVATAR_API_BASE=http://10.29.145.124:9000
# AVATAR_SAMPLE_TEXT=Read this script while recording your voice sample.
# AVATAR_VIDEO_API_BASE=http://10.29.145.124:8002

# =============================================================================
# Speech-to-text — NVIDIA Parakeet (default)
# =============================================================================
# TRANSCRIBE_BACKEND=parakeet
# TRANSCRIBE_API_URL=http://10.29.145.124:8899/v1/audio/transcriptions
# TRANSCRIBE_WHISPER_API_URL=http://10.29.145.124:8000/api/transcribe
# TRANSCRIBE_DEFAULT_LANGUAGE=english
# TRANSCRIBE_TIMEOUT_SEC=120
# TRANSCRIBE_SLICE_TIMEOUT_SEC=8
# TRANSCRIBE_MAX_UPLOAD_MB=12
# TRANSCRIBE_SLICE_MIN_BYTES=200
# TRANSCRIBE_SLICE_BATCH_SIZE=1
# TRANSCRIBE_PARAKEET_LANGUAGE=en-US
# TRANSCRIBE_PARAKEET_RESPONSE_FORMAT=json
# TRANSCRIBE_PARAKEET_RETURN_TIMESTAMPS=false
# TRANSCRIBE_PARAKEET_ENABLE_AUTOMATIC_PUNCTUATION=false
# Whisper-only when TRANSCRIBE_BACKEND=whisper:
# TRANSCRIBE_MODEL_ID=distil-whisper/distil-large-v3
# TRANSCRIBE_MODE=chunked
# TRANSCRIBE_CHUNK_LENGTH_S=10
# TRANSCRIBE_STRIDE_LENGTH_S=0

# =============================================================================
# Frontend — microphone, live STT, idle video (VITE_*)
# =============================================================================
# Mic silence → auto-stop (ms)
# VITE_MIC_SILENCE_MS=350
# VITE_VOICE_SILENCE_MS=550
# VITE_VOICE_FINAL_STOP_MS=220
# VITE_MIC_SILENCE_RMS=0.014
# VITE_VOICE_DEFAULT_LANG=en-US
# VITE_MIC_MIN_RECORD_MS=400
# VITE_MIC_MAX_RECORD_MS=45000
# VITE_MIC_MIN_TRANSCRIBE_MS=700
# VITE_MIC_MIN_TRANSCRIBE_BYTES=2400

# Live STT: parallel 20ms slices (set VITE_TRANSCRIBE_LIVE_CHUNK_MS=0)
# VITE_STT_BROWSER_INTERIM=1
# VITE_TRANSCRIBE_PARALLEL_SLICES=1
# VITE_TRANSCRIBE_SLICE_MS=20
# VITE_TRANSCRIBE_SLICE_BATCH_MS=0
# VITE_TRANSCRIBE_SLICE_MIN_RECORD_MS=0
# VITE_TRANSCRIBE_SLICE_MIN_BYTES=200
# VITE_TRANSCRIBE_SLICE_MAX_IN_FLIGHT=16
# VITE_TRANSCRIBE_LIVE_CHUNK_MS=0
# VITE_TRANSCRIBE_DIRECT_URL=
# VITE_TRANSCRIBE_MODE=chunked
# VITE_TRANSCRIBE_CHUNK_LENGTH_S=10

# Idle loop (file in frontend/public/)
# VITE_IDLE_LOOP_VIDEO=/Videofile.mp4
# IDLE_LOOP_VIDEO=/Videofile.mp4

# WebRTC UI
# VITE_WEBRTC_ICE_GATHER_TIMEOUT_MS=250
# VITE_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
# VITE_LIP_SYNC_AVATAR_MIN_DELTA_SEC=0.15
# VITE_WEBRTC_AUDIO_PLAY_MIN_DELTA_SEC=0.35
# VITE_CAPTION_HIDE_MS=2000
# VITE_MIC_TONE_ON_MS=380
# VITE_MIC_TONE_OFF_MS=340
# VITE_MIC_TONE_TAP_MS=80
# VITE_MIC_PULSE_SEC=2.2

# =============================================================================
# Video RAG — Qdrant + Garage S3 + CDN
# =============================================================================
# QDRANT_URL=http://10.29.145.124:6333
# QDRANT_API_KEY=
# QDRANT_COLLECTION_NAME=video_qa
# GARAGE_S3_ENDPOINT=http://10.29.145.124:3900
# VIDEO_QA_S3_BUCKET=video-qa
# VIDEO_QA_CDN_BASE=http://10.29.145.124:5080/live/streams/video-qa
# VIDEO_QA_VOD_STATUS_BASE=http://10.29.145.124:8090/vod/status
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=garage
# VIDEO_QA_SILENCE_NOISE_DB=-45
# VIDEO_QA_SILENCE_MIN_SEC=0.25
# VIDEO_QA_MAX_TRIM_SEC=120
# VIDEO_QA_VOICE_MATCH=true
# VIDEO_QA_MATCH_THRESHOLD=0.9

# =============================================================================
# MongoDB — avatar turns + analytics
# =============================================================================
# MONGODB_ENABLED=true
# MONGODB_URI=mongodb://admin:admin@localhost:27017/?authSource=admin
# MONGODB_DATABASE=local_hologram
# MONGODB_AVATAR_TURNS_COLLECTION=avatar_turns
# MONGODB_EXPORT_TRIGGER=true
# MONGODB_EXPORT_TRIGGER_ONLY=true

# =============================================================================
# Offline exports (when OFFLINE_EXPORTS=true)
# =============================================================================
# OFFLINE_EXPORTS_BASE_URL=http://10.29.145.124:8010
# OFFLINE_EXPORT_PROFILE_ID=working_profile
# OFFLINE_EXPORT_TTS_SERVER=http://10.29.145.124:9000
# OFFLINE_EXPORT_GPU_ID=6
# OFFLINE_EXPORT_POLL_SEC=4

# =============================================================================
# Analytics / admin
# =============================================================================
# ANALYTICS_RESET_SECRET=

# =============================================================================
# Optional vector DBs (Avatar Studio)
# =============================================================================
# PINECONE_API_KEY=
# MILVUS_URI=http://127.0.0.1:19530
# WEAVIATE_URL=http://localhost:8080
# ELASTICSEARCH_URL=https://localhost:9200

# =============================================================================
# Cloud → Chroma connectors (or configure in Avatar Studio → studio_integrations.json)
# =============================================================================
# SharePoint: AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, SHAREPOINT_SITE_URL
# Google Drive: GOOGLE_DRIVE_CREDENTIALS_PATH, GOOGLE_DRIVE_FOLDER_ID
# Dropbox: DROPBOX_ACCESS_TOKEN
# Amazon S3: S3_BUCKET, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# Azure Blob: AZURE_BLOB_CONTAINER, AZURE_STORAGE_CONNECTION_STRING
# GCS: GCS_BUCKET, GCS_CREDENTIALS_PATH, GCS_USE_ADC=1
# Per-source live sync: SHAREPOINT_LIVE_SYNC=1, GOOGLE_DRIVE_LIVE_SYNC=1, etc.
