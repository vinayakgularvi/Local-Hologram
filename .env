# Local-Hologram — active configuration (copy from .env.example for new installs).
# Loaded from repo root and backend/ on startup. Vite reads VITE_* from repo root (frontend/vite.config.js envDir).

# PORT=8080

# =============================================================================
# Production / Docker (ENVIRONMENT=production or PRODUCTION=1)
# =============================================================================
# CORS: no implicit Vite localhost list; no LAN regex unless CORS_ALLOW_PRIVATE_NETWORK=1.
# CORS_ORIGINS=https://your.public.host
# CORS_ORIGIN_REGEX=
# TRUSTED_HOSTS=localhost,127.0.0.1,your.public.host
# TRUST_FORWARDED=1
# PROXY_TRUSTED_HOSTS=10.0.0.2,127.0.0.1
# SECURITY_HEADERS=1

# =============================================================================
# Lip-sync (Wav2Lip file API)
# =============================================================================
LIPSYNC_FILE_API_URL=http://10.29.145.124:8000/lipsync/file
LIPSYNC_CHECKPOINT_PATH=checkpoints/checkpoints/Wav2Lip-SD-GAN.pt
LIPSYNC_FPS=25
LIPSYNC_FACE_DET_BATCH_SIZE=16
LIPSYNC_WAV2LIP_BATCH_SIZE=128
LIPSYNC_PAD_TOP=0
LIPSYNC_PAD_BOTTOM=10
LIPSYNC_PAD_LEFT=0
LIPSYNC_PAD_RIGHT=0
LIPSYNC_CROP_TOP=0
LIPSYNC_CROP_BOTTOM=-1
LIPSYNC_CROP_LEFT=0
LIPSYNC_CROP_RIGHT=-1
LIPSYNC_BOX_TOP=-1
LIPSYNC_BOX_BOTTOM=-1
LIPSYNC_BOX_LEFT=-1
LIPSYNC_BOX_RIGHT=-1
LIPSYNC_RESIZE_FACTOR=1
LIPSYNC_ROTATE=false
LIPSYNC_NOSMOOTH=false

# =============================================================================
# LLM (voice-turn answers; local Ollama or remote OpenAI-compatible server)
# =============================================================================
# OLLAMA_BASE=http://10.29.145.124:8000
# OLLAMA_MODEL=AFM-4.5B-Q4_K_M.gguf
MODEL_API_STYLE=openai
VOICE_MAX_TOKENS=500
# VOICE_OLLAMA_INSTRUCTION=You are a concise hologram assistant

# RAG stream → TTS/humanaudio while LLM streams (one TTS call per finished sentence)
VOICE_STREAM_HUMAN=1
VOICE_STREAM_HUMAN_UNIT=sentence
# VOICE_STREAM_HUMAN_UNIT=word
# VOICE_STREAM_HUMAN_WORDS_PER_CHUNK=3
VOICE_STREAM_HUMAN_MIN_CHARS=4
VOICE_TTS_FLUSH_SENTENCE=1

# RAG /v1/chat default when no WebRTC session (studio only). Voice uses LiveTalking UUID from /offer.
# HOLOGRAM_SESSION_ID=123

# External RAG API (optional; replaces Ollama for reply text when set)
# /v1/chat — SSE: event delta (content) + event final (answer, cart, order_done, retrieved)
# RAG_GENERATE_STREAM_URL=http://localhost:9090/v1/chat
RAG_GENERATE_STREAM_URL=http://10.29.145.124:9090/v1/chat
# Legacy: RAG_GENERATE_STREAM_URL=http://localhost:9090/api/generate/stream
# RAG_CHAT_TOP_K=6

# Chroma document RAG (Avatar Studio ingest)
RAG_MAX_UPLOAD_MB=25
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=60
RAG_RESET_SECRET=12345

# =============================================================================
# WebRTC / LiveTalking (avatar video + TTS)
# =============================================================================
WEBRTC_SIGNALING_BASE=http://10.29.145.124:8010
VOICE_DISPATCH_HUMAN=1
# human = LiveTalking /human (text TTS). humanaudio = /v1/tts/reference → /humanaudiowithpath
VOICE_DISPATCH_MODE=humanaudio
# Browser mic pipeline (not /api/voice-turn)
VITE_VOICE_PIPELINE_API=/api/voice-stream
# Pre-registered voice reference on TTS server (POST /v1/tts/reference)
VOICE_TTS_REFERENCE_ID=ref103
# Optional: override TTS endpoint (default AVATAR_API_BASE/v1/tts/reference)
# VOICE_TTS_API_URL=http://10.29.145.124:9000/v1/tts/reference

# =============================================================================
# Avatar services (voice clone + controlled video jobs)
# =============================================================================
AVATAR_API_BASE=http://10.29.145.124:9000
AVATAR_SAMPLE_TEXT="That sounds so frustrating. I can't believe they dumped all that on you last minute."

# =============================================================================
# Speech-to-text — NVIDIA Parakeet (default); TRANSCRIBE_BACKEND=whisper for legacy
# =============================================================================
TRANSCRIBE_BACKEND=parakeet
TRANSCRIBE_API_URL=http://10.29.145.124:8899/v1/audio/transcriptions
TRANSCRIBE_WHISPER_API_URL=http://10.29.145.124:8000/api/transcribe
TRANSCRIBE_DEFAULT_LANGUAGE=english
TRANSCRIBE_TIMEOUT_SEC=120
TRANSCRIBE_SLICE_TIMEOUT_SEC=8
TRANSCRIBE_MAX_UPLOAD_MB=12
TRANSCRIBE_SLICE_MIN_BYTES=200
TRANSCRIBE_SLICE_BATCH_SIZE=1
TRANSCRIBE_PARAKEET_LANGUAGE=en-US
TRANSCRIBE_PARAKEET_RESPONSE_FORMAT=json
TRANSCRIBE_PARAKEET_RETURN_TIMESTAMPS=false
TRANSCRIBE_PARAKEET_ENABLE_AUTOMATIC_PUNCTUATION=false
# Whisper-only when TRANSCRIBE_BACKEND=whisper:
TRANSCRIBE_MODEL_ID=openai/whisper-large-v3-turbo
TRANSCRIBE_MODE=chunked
TRANSCRIBE_CHUNK_LENGTH_S=10
TRANSCRIBE_STRIDE_LENGTH_S=0

# =============================================================================
# Frontend — microphone, live STT, idle video (VITE_* baked at npm run dev/build)
# =============================================================================
# Mic auto-stop after silence (server MediaRecorder uses VITE_MIC_SILENCE_MS)
VITE_MIC_SILENCE_MS=350
VITE_VOICE_SILENCE_MS=550
VITE_VOICE_FINAL_STOP_MS=220
VITE_MIC_SILENCE_RMS=0.014
VITE_VOICE_DEFAULT_LANG=en-US
VITE_MIC_MIN_RECORD_MS=400
VITE_MIC_MAX_RECORD_MS=45000
VITE_MIC_MIN_TRANSCRIBE_MS=700
VITE_MIC_MIN_TRANSCRIBE_BYTES=2400

# Live STT: 20ms slices → parallel Parakeet POSTs, join in order until mic stops
VITE_STT_BROWSER_INTERIM=1
VITE_TRANSCRIBE_PARALLEL_SLICES=1
VITE_TRANSCRIBE_SLICE_MS=40
VITE_TRANSCRIBE_SLICE_BATCH_MS=0
VITE_TRANSCRIBE_SLICE_MIN_RECORD_MS=0
VITE_TRANSCRIBE_SLICE_MIN_BYTES=200
VITE_TRANSCRIBE_SLICE_MAX_IN_FLIGHT=16
VITE_TRANSCRIBE_LIVE_CHUNK_MS=0
# Whisper final pass only (when TRANSCRIBE_BACKEND=whisper):
VITE_TRANSCRIBE_MODE=chunked
VITE_TRANSCRIBE_CHUNK_LENGTH_S=10
VITE_TRANSCRIBE_LIVE_CHUNK_LENGTH_S=5
VITE_TRANSCRIBE_LIVE_MIN_MS=100
VITE_TRANSCRIBE_LIVE_MIN_BYTES=100
# VITE_TRANSCRIBE_DIRECT_URL=http://10.29.145.124:8899/v1/audio/transcriptions

# Idle loop under frontend/public/ (runtime override via IDLE_LOOP_VIDEO from API)
VITE_IDLE_LOOP_VIDEO=/Videofile.mp4
IDLE_LOOP_VIDEO=/Videofile.mp4

# WebRTC client timing + UI
VITE_WEBRTC_ICE_GATHER_TIMEOUT_MS=1000
VITE_WEBRTC_STUN_URL=stun:stun.l.google.com:19302
VITE_LIP_SYNC_AVATAR_MIN_DELTA_SEC=2
VITE_WEBRTC_AUDIO_PLAY_MIN_DELTA_SEC=4
VITE_CAPTION_HIDE_MS=2000
VITE_MIC_TONE_ON_MS=340
VITE_MIC_TONE_OFF_MS=340
VITE_MIC_TONE_TAP_MS=80
VITE_MIC_PULSE_SEC=4.2

# =============================================================================
# Video RAG — Qdrant + Garage S3 + CDN playback
# =============================================================================
QDRANT_URL=http://10.29.145.124:6333
QDRANT_COLLECTION_NAME=video_qa
GARAGE_S3_ENDPOINT=http://10.29.145.124:3900
VIDEO_QA_S3_BUCKET=video-qa
VIDEO_QA_CDN_BASE=http://10.29.145.124:5080/live/streams/video-qa
VIDEO_QA_VOD_STATUS_BASE=http://10.29.145.124:8090/vod/status
AWS_ACCESS_KEY_ID=GK0ced94955656bfb38c929afe57fd6567
AWS_SECRET_ACCESS_KEY=adcf25c09038dead12f7406ca0fb4b7dc607767b50f5ecfa90acf9f44fd2f932
AWS_DEFAULT_REGION=garage
VIDEO_QA_SILENCE_NOISE_DB=-50
VIDEO_QA_SILENCE_MIN_SEC=0.2
VIDEO_QA_MAX_TRIM_SEC=120
VIDEO_QA_VOICE_MATCH=true
VIDEO_QA_MATCH_THRESHOLD=0.9

# =============================================================================
# Feature toggles (true/false)
# =============================================================================
VIDEO_RAG_ENABLED=false
OFFLINE_EXPORTS=false
MONGODB_EXPORT_TRIGGER=false
HOLOGRAM_TRACE=1

# =============================================================================
# MongoDB — avatar turns + analytics (always on when MONGODB_ENABLED=true)
# =============================================================================
MONGODB_ENABLED=true
MONGODB_URI=mongodb://admin:admin@localhost:27017/?authSource=admin
MONGODB_DATABASE=local_hologram
MONGODB_AVATAR_TURNS_COLLECTION=avatar_turns

# =============================================================================
# Offline exports (only when OFFLINE_EXPORTS=true)
# =============================================================================
OFFLINE_EXPORT_PROFILE_ID=working_profile
OFFLINE_EXPORT_TTS_SERVER=http://10.29.145.124:9000
OFFLINE_EXPORT_GPU_ID=6

# =============================================================================
# Analytics / admin
# =============================================================================
ANALYTICS_RESET_SECRET=12345

# =============================================================================
# Cloud → Chroma connectors (uncomment to enable; or use Avatar Studio UI)
# =============================================================================
# Microsoft SharePoint — AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET, SHAREPOINT_SITE_URL
# Google Drive — GOOGLE_DRIVE_CREDENTIALS_PATH, GOOGLE_DRIVE_FOLDER_ID
# Dropbox — DROPBOX_ACCESS_TOKEN or DROPBOX_REFRESH_TOKEN + DROPBOX_APP_KEY/SECRET
# Amazon S3 — S3_BUCKET, AWS_REGION, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# Azure Blob — AZURE_BLOB_CONTAINER, AZURE_STORAGE_CONNECTION_STRING
# Google Cloud Storage — GCS_BUCKET, GCS_CREDENTIALS_PATH or GCS_USE_ADC=1
HOLOGRAM_SELECTED_AVATAR_ID=new_avatar_106
